<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>DynamicIsland</RootNamespace>
    <AssemblyName>DynamicIsland</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Version>1.0.2</Version>
    <Authors>DynamicIsland</Authors>
    <Product>灵动岛</Product>
    <!--
      WFAC010：WinForms 分析器建议把 DPI 感知从 app.manifest 挪到 ApplicationHighDpiMode。
      但本项目主体是 WPF，PerMonitorV2 必须留在 manifest 里（WPF 靠它做逐屏 DPI 缩放），
      分析器建议不适用，屏蔽该警告。
    -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <!--
    UseWindowsForms 会让 SDK 隐式引入 System.Drawing / System.Windows.Forms，
    而它们与 WPF 侧大量同名类型冲突（Button、Color、Brushes、Point、Size、Font、FontFamily…），
    使所有 WPF 文件出现 CS0104 二义性错误。这里移除隐式引入，
    需要 WinForms 的地方统一用 `using Forms = System.Windows.Forms;` 别名或全限定名。
  -->
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

</Project>